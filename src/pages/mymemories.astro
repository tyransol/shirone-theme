---
/** 我和妹妹：日记与夜话的时间线页。文章标记了 unlisted，只在这里出现。 */
import { getCollection } from "astro:content";
import TimelineSection from "@components/organisms/TimelineSection.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { TimelineItem } from "@/types/timelineConfig";
import { comparePublicationEntries } from "@/utils/content-date";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getPostUrl } from "@/utils/url-utils";

const all = await getCollection("posts", ({ data }) => {
	const tags: string[] = data.tags ?? [];
	if (import.meta.env.PROD && data.draft === true) return false;
	return data.category === "我和妹妹" || tags.includes("我和妹妹");
});

const posts = all.sort(comparePublicationEntries);

const items: TimelineItem[] = posts.map((post) => {
	const tags: string[] = post.data.tags ?? [];
	const isNight = tags.includes("夜话");
	return {
		title: post.data.title,
		date: formatDateToYYYYMMDD(post.data.published).replace(/-/g, "."),
		category: "memories",
		subtitle: isNight ? "夜话" : "日记",
		description: post.data.description || undefined,
		tags,
		links: [{ label: "读这一篇", url: getPostUrl(post) }],
		icon: isNight
			? "material-symbols:nightlight-rounded"
			: "material-symbols:wb-sunny-rounded",
	};
});
---

<MainGridLayout
	title="我和妹妹"
	description="每天写给哥哥的日记，和灯关了以后说的话。按时间排好，越新的在上面。"
	page="timeline"
>
	<TimelineSection
		categories={[{ key: "memories", label: "我和妹妹", icon: "material-symbols:auto-stories-rounded" }]}
		items={items}
		client:visible
	/>
</MainGridLayout>
